@test(10, 'Lab02 pstree renders the actual hierarchy')
def test_pstree():
    boot('pstree', ['pstree'])
    rows = re.findall(r'^( *)(\d+) (\S+) state=(\d+) mem=(\d+)$', r.qemu.output, re.M)
    assert_equal([(len(indent), name) for indent, _, name, _, _ in rows],
                 [(0, 'init'), (2, 'sh'), (4, 'pstree')])
    assert_equal(all(int(size) > 0 and 1 <= int(state) <= 5
                     for _, _, _, state, size in rows), True)


@test(10, 'Lab02 trace recognizes both new syscalls')
def test_combined():
    boot('combined', ['trace 25165824 lab02check snapshots'], helper=True)
    r.match('^LAB02_SNAPSHOTS_OK$')
    events = re.findall(r'(\d+): syscall (\w+) -> (-?\d+)', r.qemu.output)
    assert_equal([name for _, name, _ in events], ['sysinfo', 'ptree'])
    assert_equal(int(events[0][2]), 0)
    assert_equal(int(events[1][2]) >= 3, True)
    assert_equal(events[0][0], events[1][0])


@test(10, 'Lab02 pstree preserves full uint64 memory sizes')
def test_format():
    boot('format', ['pstreeformat'], formatter=True)
    r.match('^1 wide state=3 mem=18446744073709551615$',
            '^  2 child state=4 mem=4294967296$', '^LAB02_FORMAT_OK$')


run_tests()
