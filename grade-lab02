#!/usr/bin/env python3
"""Integrated Lab 2 checks, executed in xv6 using the existing grader runtime."""

import re
import subprocess
from pathlib import Path
from gradelib import *

r = Runner()
evidence = Path('docs/lab02/validation')
evidence.mkdir(parents=True, exist_ok=True)


def boot(group, commands, helper=False, formatter=False):
    extra = []
    if helper:
        subprocess.run(['make', '-s', 'user/_lab02check'], check=True)
        extra = ['UEXTRA=user/xargstest.sh user/_lab02check']
    if formatter:
        subprocess.run(['make', '-s', 'user/_pstreeformat'], check=True)
        extra = ['UEXTRA=user/xargstest.sh user/_pstreeformat']
    maybe_unlink('fs.img')
    r.run_qemu(save(str(evidence / ('qemu-' + group + '.txt'))),
               shell_script(commands), make_args=extra, timeout=60)
    r.match(no=['LAB02_FAIL:', 'panic:', r'usertrap\(', 'exec .* failed'])


@test(10, 'Lab02 member sysinfotest')
def test_sysinfotest():
    boot('sysinfotest', ['sysinfotest'])
    r.match('^sysinfotest: OK$', no=['FAIL:'])


@test(10, 'Lab02 logical heap boundary')
def test_badbuf():
    boot('badbuf', ['lab02check badbuf'], helper=True)
    r.match(r'^LAB02_BADBUF_OK: \d+ checks$')


